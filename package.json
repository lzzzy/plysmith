{
  "name": "plysmith",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev:host": "node tools/run-development-host.ts",
    "dev:mcp": "node --enable-source-maps app/bootstrap/mcp/main.ts",
    "dev:reset": "node tools/reset-development-data.ts",
    "build:desktop": "node tools/build-desktop.ts",
    "dev:desktop": "pnpm run build:desktop && electron build/desktop/main.mjs --application-home . --install-root .",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.node.json && tsc --noEmit --pretty false -p tsconfig.renderer.json && tsc --noEmit --pretty false -p tsconfig.tests.json && tsc --noEmit --pretty false -p tsconfig.tools.json",
    "lint": "eslint .",
    "format:check": "prettier --check .dependency-cruiser.cjs .prettierrc.json eslint.config.mjs package.json pnpm-workspace.yaml \"tsconfig*.json\" \"app/**/*.{ts,tsx,css,html}\" \"configuration/**/*.json\" \"contracts/**/*.{ts,json}\" \"tests/**/*.{ts,json}\" \"tools/**/*.ts\"",
    "test": "node --test --test-isolation=none \"tests/**/*.test.ts\"",
    "check:boundaries": "depcruise --config .dependency-cruiser.cjs app contracts tests",
    "verify:host-client-browser": "node tools/verify-host-client-browser.ts",
    "verify:desktop-runtime": "node tools/verify-desktop-runtime.ts",
    "generate:configuration-schemas": "node tools/generate-configuration-schemas.ts",
    "generate:host-contract": "node tools/generate-host-contract.ts",
    "generate": "pnpm run generate:configuration-schemas && pnpm run generate:host-contract",
    "verify:generated": "node tools/verify-generated.ts",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run check:boundaries && pnpm run verify:host-client-browser && pnpm run verify:generated && pnpm run test && pnpm run build:desktop && pnpm run format:check"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/sse": "0.6.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/type-provider-typebox": "5.2.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@sinclair/typebox": "0.34.52",
    "better-sqlite3": "13.0.3",
    "chess.js": "1.4.0",
    "eventsource": "5.1.1",
    "fastify": "5.12.3",
    "lucide-react": "1.41.0",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-aria-components": "1.21.1",
    "react-dom": "19.2.8",
    "react-intl": "10.1.26"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "dependency-cruiser": "18.2.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2"
  }
}
