    "/preferences/ui-language": {
      "put": {
        "operationId": "SetUiLanguage",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "expectedRevision": {
                    "maximum": 9007199254740991,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "uiLocale": {
                    "anyOf": [
                      {
                        "enum": [
                          "de-DE"
                        ],
                        "type": "string"
                      },
                      {
                        "enum": [
                          "en-GB"
                        ],
                        "type": "string"
                      }
                    ]
                  }
                },
                "required": [
                  "uiLocale",
                  "expectedRevision"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetUiLanguageResult"
                }
              }
            },
            "description": "Default Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
