{
  "$id": "https://github.com/lzzzy/plysmith/blob/main/configuration/schemas/plysmith.schema.json",
  "additionalProperties": false,
  "properties": {
    "bindings": {
      "additionalProperties": false,
      "properties": {
        "analysisEngines": {
          "items": {
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "liveProviders": {
          "items": {
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "persistence": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "type": "string"
        },
        "playoutEngines": {
          "items": {
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "persistence",
        "analysisEngines",
        "playoutEngines",
        "liveProviders"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "schemaVersion",
    "bindings"
  ],
  "type": "object"
}
