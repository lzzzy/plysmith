{
  "$id": "https://github.com/lzzzy/plysmith/blob/main/configuration/schemas/maia-chess-provider.schema.json",
  "additionalProperties": false,
  "properties": {
    "displayName": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    },
    "maia": {
      "additionalProperties": false,
      "properties": {
        "executablePath": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "maxOutputBytes": {
          "maximum": 16777216,
          "minimum": 1024,
          "type": "integer"
        },
        "moveTimeoutMs": {
          "maximum": 60000,
          "minimum": 100,
          "type": "integer"
        },
        "startupTimeoutMs": {
          "maximum": 60000,
          "minimum": 100,
          "type": "integer"
        },
        "stopTimeoutMs": {
          "maximum": 30000,
          "minimum": 100,
          "type": "integer"
        },
        "weightsPath": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "executablePath",
        "weightsPath",
        "startupTimeoutMs",
        "moveTimeoutMs",
        "stopTimeoutMs",
        "maxOutputBytes"
      ],
      "type": "object"
    },
    "provider": {
      "const": "maia-chess",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "schemaVersion",
    "provider",
    "displayName",
    "maia"
  ],
  "type": "object"
}
