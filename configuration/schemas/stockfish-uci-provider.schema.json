{
  "$id": "https://github.com/lzzzy/plysmith/blob/main/configuration/schemas/stockfish-uci-provider.schema.json",
  "additionalProperties": false,
  "properties": {
    "displayName": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    },
    "provider": {
      "const": "stockfish-uci",
      "type": "string"
    },
    "schemaVersion": {
      "const": 2,
      "type": "number"
    },
    "stockfish": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "items": {
            "maxLength": 1024,
            "type": "string"
          },
          "maxItems": 32,
          "type": "array"
        },
        "detailLevels": {
          "additionalProperties": false,
          "properties": {
            "fast": {
              "maximum": 600000,
              "minimum": 10,
              "type": "integer"
            },
            "thorough": {
              "maximum": 600000,
              "minimum": 10,
              "type": "integer"
            },
            "very_deep": {
              "maximum": 600000,
              "minimum": 10,
              "type": "integer"
            }
          },
          "required": [
            "fast",
            "thorough",
            "very_deep"
          ],
          "type": "object"
        },
        "executablePath": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "hashMb": {
          "maximum": 65536,
          "minimum": 1,
          "type": "integer"
        },
        "maxOutputBytes": {
          "maximum": 16777216,
          "minimum": 1024,
          "type": "integer"
        },
        "moveTimeoutMs": {
          "maximum": 660000,
          "minimum": 100,
          "type": "integer"
        },
        "playoutBudget": {
          "anyOf": [
            {
              "const": "fast",
              "type": "string"
            },
            {
              "const": "thorough",
              "type": "string"
            },
            {
              "const": "very_deep",
              "type": "string"
            }
          ]
        },
        "startupTimeoutMs": {
          "maximum": 60000,
          "minimum": 100,
          "type": "integer"
        },
        "stopTimeoutMs": {
          "maximum": 30000,
          "minimum": 100,
          "type": "integer"
        },
        "threads": {
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "executablePath",
        "arguments",
        "threads",
        "hashMb",
        "detailLevels",
        "playoutBudget",
        "startupTimeoutMs",
        "moveTimeoutMs",
        "stopTimeoutMs",
        "maxOutputBytes"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "provider",
    "displayName",
    "stockfish"
  ],
  "type": "object"
}
